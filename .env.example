# Copy to .env.local (Next.js) and .env (scripts). Never commit real values.

# Postgres. On Vercel use the Supabase *transaction pooler* URL (port 6543).
DATABASE_URL=
# Optional: direct/session connection (port 5432) used by migrations.
DATABASE_URL_DIRECT=

# Public base URL of the deployment, e.g. https://your-app.vercel.app (used in links/webhooks).
APP_URL=

# 32-byte key, base64. Encrypts per-workspace integration secrets at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Shared secret required by /api/worker/tick (sent by Supabase pg_cron as a Bearer token).
WORKER_SECRET=

# Google OAuth client (platform-level app; each employee connects their own account).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

